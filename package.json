{
  "name": "smartwallet",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:shared": "npm run build -w @smartwallet/shared",
    "build": "npm run build:shared && npm run build -w @smartwallet/api && npm run build -w @smartwallet/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run build:shared && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "web:mock": "npm run dev:mock -w @smartwallet/web",
    "web:real": "npm run dev:real -w @smartwallet/web"
  }
}
