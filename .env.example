# Copy to .env for local dev. NEVER commit real secrets.
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh

# Postgres
POSTGRES_USER=smartwallet
POSTGRES_PASSWORD=change-me
POSTGRES_DB=smartwallet
DATABASE_URL=postgresql://smartwallet:change-me@postgres:5432/smartwallet?schema=public

# Redis
REDIS_URL=redis://redis:6379

# API
API_PORT=3000
APP_URL=http://localhost:5173
JWT_ACCESS_SECRET=change-me-access
JWT_ACTION_SECRET=change-me-action  # signs email-verify + password-reset links
COOKIE_SECURE=false

# Google OAuth (AUTH-03)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SmartWallet <no-reply@smartwallet.local>

# S3 (private bucket, pre-signed URLs)
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=   # optional: MinIO/LocalStack for local dev (path-style)

# Web
VITE_API_URL=http://localhost:3000/api/v1

# Mail: console (prints links to the api log) locally, ses in production
MAIL_TRANSPORT=console
AWS_REGION=ap-southeast-1

# Seed (dev only; SEED_ADMIN_PASSWORD is REQUIRED when NODE_ENV=production, demo user is skipped in production)
SEED_ADMIN_EMAIL=admin@smartwallet.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_DEMO_PASSWORD=Demo@12345

# Recurring transactions (BullMQ). RECURRING_WORKER=off disables the worker on this instance.
RECURRING_WORKER=on
RECURRING_INTERVAL_MS=60000
BULL_PREFIX=sw

# Background jobs (BullMQ, Vietnam time). WORKERS=off disables every worker on this instance (run them on a dedicated one).
WORKERS=on
WEEKLY_SUMMARY_CRON="0 9 * * 1"
GOAL_CHECK_CRON="0 8 * * *"
# Socket.IO fan-out across API instances via Redis (set off for a single instance)
WS_REDIS_ADAPTER=on
